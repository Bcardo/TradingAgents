# Web UI
GRADIO_USERS=you:yourpassword,friend:friendpassword   # comma-separated user:password pairs
GRADIO_PORT=7860
WEB_LLM_PROVIDER=qwen          # openai | anthropic | google | ollama | deepseek | ...
WEB_DEEP_MODEL=qwen3.5-plus            # model for Research Manager + Portfolio Manager
WEB_QUICK_MODEL=qwen3.5-Flash      # model for all other agents
WEB_BACKEND_URL=                 # leave blank for cloud APIs; set to http://localhost:11434/v1 for Ollama

# Data paths (optional — defaults to ~/.tradingagents)
# Set TRADINGAGENTS_HOME to control where logs, cache, and memory are stored.
# On HF Spaces with persistent storage: TRADINGAGENTS_HOME=/data
TRADINGAGENTS_HOME=

# AWS S3 memory persistence (optional — memory is local-only if not set)
# Create a private S3 bucket and an IAM user with s3:GetObject + s3:PutObject on it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_MEMORY_BUCKET=
# Use different keys per environment to avoid dev/prod collisions:
#   local:     S3_MEMORY_KEY=dev/trading_memory.md
#   HF Spaces: S3_MEMORY_KEY=prod/trading_memory.md
S3_MEMORY_KEY=dev/trading_memory.md

# Reddit (optional — overrides the default user-agent for Reddit public API requests)
# Format: python:<app-id>:<version> (by /u/<your-reddit-username>)
REDDIT_USER_AGENT=python:com.tradingagents:v1.0 (by /u/tradingagents_bot)

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
